# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Remote execution cache and local settings
.rx/
.rx.json

# Stop file for unattended runs
.rip-stop

# Raw run trees never enter git (docs/BIBLE.md, Repository Layout)
lassi-runs/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Upstream LASSI checkout, fetched at its pinned commit by tools/fetch_upstream.py (not tracked; OQ-018)
third_party/LASSI/

# Upstream LASSI text generated by tools/extract_lassi_assets.py (OQ-018): only the manifests are tracked
/assets/prompts/lassi-2024/*
!/assets/prompts/lassi-2024/MANIFEST.yaml
/assets/context/openmp-4.0-card/*
!/assets/context/openmp-4.0-card/MANIFEST.yaml
/assets/context/cuda-12.5-ch5/*
!/assets/context/cuda-12.5-ch5/MANIFEST.yaml

# tt-metal text generated by tools/build_tt_context.py from the pinned tree, kept out as OQ-018 keeps upstream text
/assets/context/tt-metalium-5280a9cf/*
!/assets/context/tt-metalium-5280a9cf/MANIFEST.yaml
/assets/context/tt-metalium-5280a9cf-full/*
!/assets/context/tt-metalium-5280a9cf-full/MANIFEST.yaml

# tt-metal's example programs written by tools/build_tt_examples.py from the pinned tree: only the spec and manifest
/assets/examples/tt-examples-v0/*
!/assets/examples/tt-examples-v0/MANIFEST.yaml
!/assets/examples/tt-examples-v0/spec.yaml
