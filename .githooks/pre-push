#!/bin/sh
# Blocks pushes that carry policy violations: branch names and every commit
# message and identity in the pushed range.
. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"
ROOT="$(repo_root)"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  case "$remote_ref" in
    refs/heads/*)
      name="${remote_ref#refs/heads/}"
      run_py "$ROOT/tools/check_text_policy.py" --branch "$name" </dev/null || status=1
      ;;
  esac
  if [ "$remote_sha" = "$ZERO" ]; then
    run_py "$ROOT/tools/check_text_policy.py" --range "$local_sha --not --remotes" </dev/null || status=1
  else
    run_py "$ROOT/tools/check_text_policy.py" --range "$remote_sha..$local_sha" </dev/null || status=1
  fi
done
exit $status
